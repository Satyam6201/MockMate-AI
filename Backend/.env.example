# Server Port (Render sets PORT automatically, defaults to 8000 if omitted)
PORT=8000
NODE_ENV=production

# MongoDB Database Connection String (MongoDB Atlas URI)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/mockmate?retryWrites=true&w=majority

# JWT Secret for cookie authentication
JWT_SECRET_KEY=your_jwt_secret_key_here

# OpenRouter / AI API Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxx

# Frontend URL (Your Vercel deployment URL, e.g. https://your-project.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_MOCK=false

# Redis URL (Optional for rate limiting / socket adapter - Upstash Redis or Render Redis)
# If not provided, rate limiting and socket work locally / in-memory
REDIS_URL=redis://default:<password>@<host>:<port>